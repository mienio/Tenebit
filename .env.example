# Template for the real .env, which is gitignored and never committed. Copy it, fill every value in, and
# keep the two in step: docker-compose.yml reads these names directly, so a key missing here is a key the
# next person deploying will not know they had to set.
#
# Nothing in this file is a real credential. Placeholders are shaped like the values they stand in for so a
# half-filled file is obvious at a glance rather than failing somewhere deep in a payment flow.

# --- Database -----------------------------------------------------------------------------------------
TENEBIT_DB_PASSWORD=

# --- Application secrets ------------------------------------------------------------------------------
# Random, high-entropy, and rotating either one invalidates data: the signing key logs everybody out, the
# field encryption key makes existing encrypted columns unreadable. Generate with `openssl rand -base64 48`.
TENEBIT_SIGNING_KEY=
TENEBIT_FIELD_ENCRYPTION_KEY=

# --- Public addressing --------------------------------------------------------------------------------
# Must be the real public origin: it goes into e-mail links, and Paddle's default payment link has to point
# at the same host. Not localhost in anything Paddle touches - live checkouts reject it.
TENEBIT_PUBLIC_URL=https://example.com
TENEBIT_ALLOWED_HOSTS=example.com

# --- Outbound mail ------------------------------------------------------------------------------------
TENEBIT_SMTP_HOST=
TENEBIT_SMTP_PORT=587
TENEBIT_SMTP_USERNAME=
TENEBIT_SMTP_PASSWORD=
TENEBIT_SMTP_FROM=
TENEBIT_SMTP_FROM_NAME=Tenebit
TENEBIT_SMTP_USE_SSL=true

# --- Seeded demo account ------------------------------------------------------------------------------
TENEBIT_DEMO_EMAIL=
TENEBIT_DEMO_PASSWORD=

# --- Platform admin -----------------------------------------------------------------------------------
# The password is stored only as an argon2 hash; the TOTP secret is the base32 seed for the 2FA app.
TENEBIT_ADMIN_EMAIL=
TENEBIT_ADMIN_PASSWORD_HASH=
TENEBIT_ADMIN_TOTP_SECRET=

# --- Paddle -------------------------------------------------------------------------------------------
# "production" or "sandbox". This one value decides the API host, which set of webhook source IPs is
# fetched, and whether Paddle.js is switched into sandbox mode in the browser - the credentials and price
# ids below must come from the matching account, they are not interchangeable between the two.
TENEBIT_PADDLE_ENVIRONMENT=sandbox

# Server-side API key (Paddle > Developer tools > Authentication). Secret - never sent to the browser.
# Live keys are prefixed pdl_live_, sandbox ones pdl_sdbx_.
TENEBIT_PADDLE_API_KEY=

# Client-side token from the same screen. Public by design: the browser receives it from
# GET /api/subscription/paddle-config, exactly like a Stripe publishable key. live_... or test_...
TENEBIT_PADDLE_CLIENT_TOKEN=

# The notification destination's signing secret (Paddle > Developer tools > Notifications), pdl_ntfset_...
# Shown once when the destination is created and never retrievable again. Recreating a destination issues a
# new one and silently invalidates every delivery signed with the old secret, so rotate deliberately.
TENEBIT_PADDLE_WEBHOOK_SECRET=

# Price ids per plan and billing interval, from the Paddle catalog of the account named above.
# ENTERPRISE is the internal key for the plan marketed as "Max" - the names differ on purpose.
TENEBIT_PADDLE_PRICE_STARTER_MONTHLY=pri_
TENEBIT_PADDLE_PRICE_STARTER_ANNUAL=pri_
TENEBIT_PADDLE_PRICE_GROWTH_MONTHLY=pri_
TENEBIT_PADDLE_PRICE_GROWTH_ANNUAL=pri_
TENEBIT_PADDLE_PRICE_BUSINESS_MONTHLY=pri_
TENEBIT_PADDLE_PRICE_BUSINESS_ANNUAL=pri_
TENEBIT_PADDLE_PRICE_ENTERPRISE_MONTHLY=pri_
TENEBIT_PADDLE_PRICE_ENTERPRISE_ANNUAL=pri_

# --- Cloudflare Turnstile -----------------------------------------------------------------------------
# Secret key is server-side; the site key is rendered into the page and is public.
TENEBIT_TURNSTILE_SECRET_KEY=
TENEBIT_TURNSTILE_SITE_KEY=
