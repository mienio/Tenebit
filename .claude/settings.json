{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "PowerShell(Get-* *)",
      "PowerShell(ls *)",
      "PowerShell(dir *)",
      "PowerShell(cat *)",
      "PowerShell(Select-String *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)"
    ],
    "defaultMode": "bypassPermissions"
  }
}
